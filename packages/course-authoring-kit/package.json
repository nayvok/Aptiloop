{
  "name": "@aptiloop/course-authoring-kit",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./authoring-assets": {
      "types": "./src/authoring-assets.ts",
      "import": "./src/authoring-assets.ts"
    }
  },
  "bin": {
    "aptiloop-course-pack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "templates"
  ],
  "scripts": {
    "build": "npm run generate && tsup",
    "generate": "tsx scripts/generate-assets.ts && prettier --write schema templates",
    "lint": "eslint src test scripts --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aptiloop/learning-core": "0.1.0",
    "@aptiloop/shared": "0.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
