# Explicit local development mode permits deterministic Mock learning only.
NODE_ENV=development

# Orchestrator binds to loopback by default.
PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3000

# M1 writable runtime/CLI access is fixed to the active repository database.
DATABASE_URL=.data/dev-learning-harness.sqlite
# Approved backups require explicit CLI source/destination paths; no directory is auto-discovered.

# Trusted bundled templates and server-created isolated learner attempts.
WORKSPACE_ROOT=workspaces/exercises
EXERCISE_ATTEMPTS_ROOT=.data/exercise-attempts
ZED_EXECUTABLE=zed

# Web server-side rewrite/build output. NEXT_DIST_DIR is useful for isolated E2E.
ORCHESTRATOR_URL=http://127.0.0.1:8787
NEXT_DIST_DIR=.next

# Optional constrained Pi providers. Secrets are read only from the local
# environment/root .env and are never stored in browser settings or SQLite.
# OPENAI_API_KEY=
# OPENCODE_API_KEY=

# The legacy Codex/OpenCode CLI adapters remain diagnostics-only and are not
# available to learning roles.
