# Orchestrator binds to loopback by default.
PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3000

# Relative database paths are resolved from DATABASE_PROJECT_ROOT (or the repo root).
DATABASE_PROJECT_ROOT=.
DATABASE_URL=.data/dev-learning-harness.sqlite
DATABASE_BACKUP_DIR=.data/backups

# Trusted bundled templates and server-created isolated learner attempts.
WORKSPACE_ROOT=workspaces/exercises
EXERCISE_ATTEMPTS_ROOT=.data/exercise-attempts
ZED_EXECUTABLE=zed

# Web server-side rewrite/build output. NEXT_DIST_DIR is useful for isolated E2E.
ORCHESTRATOR_URL=http://127.0.0.1:8787
NEXT_DIST_DIR=.next

# OpenCode endpoint must be HTTP loopback without credentials/path/query/fragment.
OPENCODE_ENDPOINT=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD is read only from the environment and never stored.
# Codex reuses the local Codex CLI authentication store; no Codex token is required here.
